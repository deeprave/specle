{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specle://schemas/change-status/1.0",
  "type": "object",
  "required": [
    "$schema",
    "kind",
    "status",
    "created_at",
    "activated_at",
    "progress",
    "verification",
    "review",
    "delivery",
    "relationships",
    "dependencies"
  ],
  "properties": {
    "$schema": {"const": "specle://schemas/change-status/1.0"},
    "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "status": {"type": "string", "minLength": 1},
    "created_at": {"type": "number"},
    "activated_at": {"type": ["number", "null"]},
    "updated_at": {"type": "number"},
    "archived_at": {"type": "number"},
    "progress": {
      "type": "object",
      "properties": {
        "tasks_completed": {"type": "integer", "minimum": 0},
        "tasks_total": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "findings": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "delivery": {
      "type": ["object", "null"],
      "properties": {
        "completion": {
          "type": "object",
          "required": ["reference", "head_branch", "target_branch", "event"],
          "properties": {
            "reference": {"type": "string", "minLength": 1},
            "head_branch": {"type": "string", "minLength": 1},
            "target_branch": {"type": "string", "minLength": 1},
            "commit": {"type": "string", "minLength": 1},
            "event": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["change", "type"],
        "properties": {
          "change": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "delivery": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
