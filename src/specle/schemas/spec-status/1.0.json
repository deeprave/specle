{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deeprave/specle/schemas/spec-status/1.0",
  "type": "object",
  "required": [
    "$schema",
    "kind",
    "status",
    "progress",
    "verification",
    "review",
    "delivery",
    "relationships",
    "dependencies"
  ],
  "properties": {
    "$schema": {"const": "https://github.com/deeprave/specle/schemas/spec-status/1.0"},
    "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "status": {"type": "string", "minLength": 1},
    "progress": {
      "type": "object",
      "properties": {
        "tasks_completed": {"type": "integer", "minimum": 0},
        "tasks_total": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "findings": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "delivery": {"type": ["object", "null"], "additionalProperties": true},
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["spec", "type"],
        "properties": {
          "spec": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "not": {
    "anyOf": [
      {"required": ["name"]},
      {"required": ["path"]},
      {"required": ["next"]},
      {"required": ["current_spec"]},
      {"required": ["recent_specs"]},
      {"required": ["queued_specs"]}
    ]
  },
  "additionalProperties": true
}
