      "items": {"$ref": "https://github.com/deeprave/specle/schemas/common/1.0#/$defs/record"}
    },
    "queued_specs": {
      "type": "array",
      "items": {"$ref": "https://github.com/deeprave/specle/schemas/common/1.0#/$defs/record"}
    }
  },
  "additionalProperties": true
}
